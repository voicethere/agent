{
  "name": "docs-rag-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Build a hybrid (vector + full-text) docs index and search it",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "docs-rag": "./src/cli.ts"
  },
  "scripts": {
    "download-model": "node src/download-model.ts",
    "build-index": "node src/cli.ts build",
    "eval": "node src/cli.ts eval",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "better-sqlite3": "13.0.3",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
